# Скопируйте в .env и раскомментируйте нужное.
# Если переменные не заданы, используется локальный unix-сокет PostgreSQL
# и текущий пользователь ОС (peer/trust-аутентификация, macOS/Linux).

DB_NAME=stock_prediction

# Для удалённой БД или Windows:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=secret

# Либо одной строкой (имеет приоритет над DB_*):
# DATABASE_URL=postgresql://postgres:secret@localhost:5432/stock_prediction
